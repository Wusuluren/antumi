{
  "name": "antumi",
  "version": "0.20.0-beta.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs",
    "dev": "pnpm --parallel --filter @antumi/daemon --filter @antumi/core --filter @antumi/desktop run dev",
    "dev:daemon": "pnpm --filter @antumi/daemon run dev",
    "dev:core": "pnpm --filter @antumi/core run dev",
    "dev:desktop": "pnpm --filter @antumi/desktop run dev",
    "build": "pnpm --filter @antumi/desktop run build",
    "typecheck": "pnpm --filter @antumi/plugin-sdk build && pnpm -r run typecheck",
    "test": "pnpm --filter @antumi/plugin-sdk build && vitest run",
    "verify:plugin-sdk": "node scripts/verify-plugin-sdk.mjs",
    "test:dsh-runtime": "node --import tsx scripts/smoke-dsh-runtime.mjs",
    "dist:mac": "pnpm --filter @antumi/desktop run dist:mac",
    "dist:win": "pnpm --filter @antumi/desktop run dist:win"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.25.12",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
