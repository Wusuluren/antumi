{
  "name": "antumi",
  "version": "0.18.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs",
    "dev": "pnpm --parallel --filter @antumi/daemon --filter @antumi/core --filter @antumi/desktop run dev",
    "dev:daemon": "pnpm --filter @antumi/daemon run dev",
    "dev:core": "pnpm --filter @antumi/core run dev",
    "dev:desktop": "pnpm --filter @antumi/desktop run dev",
    "build": "pnpm --filter @antumi/desktop run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "dist:mac": "pnpm --filter @antumi/desktop run dist:mac"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.25.12",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
