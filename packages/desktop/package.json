{
  "name": "@antumi/desktop",
  "productName": "Antumi",
  "version": "0.20.0-beta.2",
  "private": true,
  "description": "Antumi desktop client",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyhero/antumi.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "node ../../scripts/build-plugins.mjs && electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "bundle:backend": "node scripts/bundle-backend.mjs",
    "dist:mac": "electron-vite build && node scripts/bundle-backend.mjs --platform darwin && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && node scripts/bundle-backend.mjs --platform win32 && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@antumi/protocol": "workspace:*",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@replit/codemirror-indentation-markers": "6.5.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "catalog:",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "lowlight": "3.3.0",
    "material-icon-theme": "5.39.0",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-gfm": "4.0.1",
    "typescript": "catalog:",
    "vite": "^7.3.0",
    "ws": "catalog:",
    "zod": "catalog:",
    "zustand": "5.0.15"
  }
}
